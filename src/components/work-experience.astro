---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "../components/portable-text.astro";
import { formatDateRangeHelper } from "../utils/helpers";

interface WorkExperience {
  title: string;
  jobTitle: string;
  startDate: string;
  endDate: string;
  current: boolean;
  companyName: string;
  modality: string;
  jobDescription: any[];
  chronoIndex: number;
}

const { data: workExperiences } = await loadQuery<WorkExperience[]>({
  query: `*[_type == "workExperience"] {
    title,
    jobTitle,
    startDate,
    endDate,
    current,
    companyName,
    modality,
    jobDescription,
    chronoIndex
  }`,
});
---

<section>
  <p class="text-xl lg:text-2xl font-medium mb-2 lg:mb-4">Work Experience</p>

  {
    workExperiences
      ?.sort((a, b) => b.chronoIndex - a.chronoIndex)
      ?.map((experience) => {
        const { formattedStart, formattedEnd } = formatDateRangeHelper({
          startDate: experience.startDate,
          endDate: experience.endDate,
          current: experience.current,
        });

        return (
          <article class="my-3 font-normal text-base">
            <p class="text-base lg:text-lg font-medium">
              {experience.jobTitle}
            </p>
            <p class="text-base lg:text-lg italic">
              {experience.companyName}, {experience.modality} | {formattedStart}{" "}
              - {formattedEnd}
            </p>
            <div
              class="font-normal text-gray-800 text-justify leading-relaxed"
              id="block-content"
            >
              <PortableText portableText={experience.jobDescription} />
            </div>
          </article>
        );
      })
  }
</section>

<style>
  :global(#block-content ul) {
    list-style-type: disc;
    @apply ml-4;
  }
</style>
