---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "../components/portable-text.astro";
import { formatDateRangeHelper } from "../utils/helpers";

interface volunteering {
  title: string;
  role: string;
  startDate: string;
  endDate: string;
  current: boolean;
  organization: string;
  description: any[];
  chronoIndex: number;
}

const { data } = await loadQuery<volunteering[]>({
  query: `*[_type == "volunteering"] {
    title,
    role,
    startDate,
    endDate,
    current,
    organization,
    description,
    chronoIndex
  }`,
});
---

<section>
  <!-- Volunteering -->
  <article>
    <p class="text-xl lg:text-2xl font-medium mb-2 lg:mb-4">Volunteering</p>
    {
      data
        ?.sort((a, b) => b.chronoIndex - a.chronoIndex)
        ?.map((items) => {
          const { formattedStart, formattedEnd } = formatDateRangeHelper({
            startDate: items.startDate,
            endDate: items.endDate,
            current: items.current,
          });

          return (
            <article class="my-3">
              <p class="text-base lg:text-lg font-medium">{items.role}</p>
              <p class="text-base lg:text-lg italic">
                {items.organization} | {formattedStart} - {formattedEnd}
              </p>
              <div
                class="font-normal text-gray-800 text-justify leading-relaxed"
                id="block-content"
              >
                <PortableText portableText={items.description} />
              </div>
            </article>
          );
        })
    }
  </article>
</section>
