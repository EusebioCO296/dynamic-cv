---
import { Icon } from "astro-icon/components";

import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "./portable-text.astro";

interface AboutMe {
  title: string;
  firstName: string;
  surname: string;
  jobTitle: string;
  defaultContactInfo: {
    phone: string;
    city: string;
    country: string;
  };
  dynamicContactInfo: any[];
  email: string;
  links: any[];
  skills: any[];
  languages: any[];
  bio: any;
}

const { data } = await loadQuery<AboutMe[]>({
  query: `*[_type == "aboutMe"] {
    title,
    firstName,
    surname,
    jobTitle,
    city,
    country,
    phone,
    defaultContactInfo{...},
    dynamicContactInfo[] {...,},
    email,
    links[] {...,},
    skills[] {...,},
    languages[] {...,},
    bio
  }`,
});

const aboutMe = data[0];
---

<section class="text-gray-900">
  <article>
    <p class="text-2xl lg:text-4xl font-medium">
      {aboutMe.firstName}
    </p>
    <p class="text-4xl lg:text-6xl font-thin py-2 lg:py-5">{aboutMe.surname}</p>
    <p class="font-normal text-lg">{aboutMe.jobTitle}</p>
  </article>

  <!-- Bio -->
  <!-- <article class="mt-5 leading-relaxed">
    <p class="text-2xl font-medium mb-4">About Me</p>
    <p class="font-normal text-gray-800 text-justify">{aboutMe.bio}</p>
  </article>
  <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" /> -->

  <!-- Contact Info -->
  <article class="mt-5 font-normal text-base">
    <p class="text-xl lg:text-2xl font-medium">Contact Info</p>
    <div class="flex items-center my-2">
      <Icon name="location" class="w-4 h-4 lg:w-6 lg:h-6" />
      <p class="ml-2" id="location-based-content">
        {aboutMe.defaultContactInfo.city}, {aboutMe.defaultContactInfo.country}
      </p>
    </div>
    <div class="flex items-center my-1 lg:my-2">
      <Icon name="phone" class="w-4 h-4 lg:w-6 lg:h-6" />
      <p class="ml-2" id="phone-based-content">
        {aboutMe.defaultContactInfo.phone}
      </p>
    </div>
    <div class="flex items-center my-2">
      <Icon name="email" class="w-4 h-4 lg:w-6 lg:h-6" />
      <p class="ml-2">{aboutMe.email}</p>
    </div>
  </article>
  <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />

  <!-- Social Links -->
  <article class="font-normal text-base">
    <p class="text-xl lg:text-2xl font-medium">Social Links</p>
    {
      aboutMe.links?.map((items: { platformName: string; link: string }) => (
        <div class="flex items-center">
          <span class="mr-2">{items.platformName}:</span>
          <a href={items.link} target="_blank" rel="noopener noreferrer">
            {items.link}
          </a>
        </div>
      ))
    }
  </article>
  <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />

  <!-- Skills -->
  <article class="font-normal text-base leading-relaxed">
    <p class="text-xl lg:text-2xl font-medium">Skills</p>
    <PortableText portableText={aboutMe.skills} />
  </article>
  <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />

  <!-- Languages -->
  <article>
    <p class="text-xl lg:text-2xl font-medium">Languages</p>
    <PortableText portableText={aboutMe.languages} />
  </article>
</section>

<script
  type="module"
  define:vars={{
    dynamicContactInfo: aboutMe.dynamicContactInfo,
    defaultContactInfo: aboutMe.defaultContactInfo,
  }}
>
  import { checkContinentCodeHelper } from "./src/utils/helpers";

  async function init() {
    if (defaultContactInfo?.isActive === true) {
      return;
    }

    const regionInfo = await checkContinentCodeHelper(dynamicContactInfo);
    if (!regionInfo) return;

    const { city, country, phone } = regionInfo;
    const locationContent = document.getElementById("location-based-content");
    const phoneContent = document.getElementById("phone-based-content");

    if (locationContent && phoneContent) {
      locationContent.innerHTML = `<p class="">${city}, ${country}</p>`;
      phoneContent.innerHTML = `<p class="">${phone}</p>`;
    }
  }

  init();
</script>

<style>
  @media print {
    .separator {
      width: 220px;
    }
  }
</style>
