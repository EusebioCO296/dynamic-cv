---
import { Icon } from "astro-icon/components";

import { loadQuery } from "../sanity/lib/load-query";
import { type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props as Props;

interface AboutMe {
  title: string;
  firstName: string;
  surname: string;
  jobTitle: string;
  jobTitleEs?: string;
  defaultContactInfo: {
    phone: string;
    city: string;
    country: string;
  };
  dynamicContactInfo: any[];
  email: string;
  links: any[];
}

const { data } = await loadQuery<AboutMe[]>({
  query: `*[_type == "aboutMe"] {
    title,
    firstName,
    surname,
    jobTitle,
    jobTitleEs,
    city,
    country,
    phone,
    defaultContactInfo{...},
    dynamicContactInfo[] {...,},
    email,
    links[] {...,}
  }`,
});

const aboutMe = data[0];

const jobTitle =
  lang === "es" ? (aboutMe.jobTitleEs ?? aboutMe.jobTitle) : aboutMe.jobTitle;
---

<section class="text-gray-900">
  <article>
    <h1 class="text-3xl lg:text-5xl font-medium leading-tight">
      {aboutMe.firstName}
      <span class="font-thin">{aboutMe.surname}</span>
    </h1>
    <p class="font-normal text-lg lg:text-xl text-gray-700 mt-1">
      {jobTitle}
    </p>
  </article>

  <!-- Contact line -->
  <article
    class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm lg:text-base text-gray-800"
  >
    <span class="inline-flex items-center gap-1">
      <Icon name="location" class="w-4 h-4" />
      <span id="location-based-content"
        >{aboutMe.defaultContactInfo.city}, {
          aboutMe.defaultContactInfo.country
        }</span
      >
    </span>
    <span class="text-gray-300" aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      <Icon name="phone" class="w-4 h-4" />
      <span id="phone-based-content">{aboutMe.defaultContactInfo.phone}</span>
    </span>
    <span class="text-gray-300" aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      <Icon name="email" class="w-4 h-4" />
      <a href={`mailto:${aboutMe.email}`}>{aboutMe.email}</a>
    </span>
    {
      aboutMe.links?.map((items: { platformName: string; link: string }) => (
        <>
          <span class="text-gray-300" aria-hidden="true">
            ·
          </span>
          <a href={items.link} target="_blank" rel="noopener noreferrer">
            {items.platformName}
          </a>
        </>
      ))
    }
  </article>
</section>

<script
  type="module"
  define:vars={{
    dynamicContactInfo: aboutMe.dynamicContactInfo,
    defaultContactInfo: aboutMe.defaultContactInfo,
  }}
>
  import { checkContinentCodeHelper } from "./src/utils/helpers";

  async function init() {
    if (defaultContactInfo?.isActive === true) {
      return;
    }

    const regionInfo = await checkContinentCodeHelper(dynamicContactInfo);
    if (!regionInfo) return;

    const { city, country, phone } = regionInfo;
    const locationContent = document.getElementById("location-based-content");
    const phoneContent = document.getElementById("phone-based-content");

    if (locationContent && phoneContent) {
      locationContent.textContent = `${city}, ${country}`;
      phoneContent.textContent = phone;
    }
  }

  init();
</script>
