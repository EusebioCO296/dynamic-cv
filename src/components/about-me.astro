---
import { loadQuery } from "../sanity/lib/load-query";
import { type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props as Props;

interface AboutMe {
  title: string;
  firstName: string;
  surname: string;
  jobTitle: string;
  jobTitleEs?: string;
  defaultContactInfo: {
    phone: string;
    city: string;
    country: string;
    cityEs?: string;
    countryEs?: string;
  };
  dynamicContactInfo: any[];
  email: string;
  links: any[];
}

const { data } = await loadQuery<AboutMe[]>({
  query: `*[_type == "aboutMe"] {
    title,
    firstName,
    surname,
    jobTitle,
    jobTitleEs,
    city,
    country,
    phone,
    defaultContactInfo{...},
    dynamicContactInfo[] {...,},
    email,
    links[] {...,}
  }`,
});

const aboutMe = data[0];

const jobTitle =
  lang === "es" ? (aboutMe.jobTitleEs ?? aboutMe.jobTitle) : aboutMe.jobTitle;

// ponytail: el "|" del cargo separa profesión y especialidad; cada tramo va en
// su propia línea. Sin "|" queda una sola, igual que antes.
const jobTitleLines = jobTitle
  .split("|")
  .map((part) => part.trim())
  .filter(Boolean);

const city =
  lang === "es"
    ? (aboutMe.defaultContactInfo.cityEs ?? aboutMe.defaultContactInfo.city)
    : aboutMe.defaultContactInfo.city;
const country =
  lang === "es"
    ? (aboutMe.defaultContactInfo.countryEs ??
      aboutMe.defaultContactInfo.country)
    : aboutMe.defaultContactInfo.country;
---

<section class="text-gray-900">
  <article>
    <h1 class="text-3xl lg:text-5xl font-thin leading-tight">
      {aboutMe.firstName}
      <span class="font-thin">{aboutMe.surname}</span>
    </h1>
    <p class="font-normal text-lg lg:text-xl text-gray-700 mt-1">
      {
        jobTitleLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
  </article>

  <!-- Contact line -->
  <article
    class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm lg:text-base text-gray-800"
  >
    <span id="location-based-content">{city}, {country}</span>
    <span class="text-gray-300" aria-hidden="true">·</span>
    <span id="phone-based-content">{aboutMe.defaultContactInfo.phone}</span>
    <span class="text-gray-300" aria-hidden="true">·</span>
    <a href={`mailto:${aboutMe.email}`}>{aboutMe.email}</a>
    {
      aboutMe.links?.map((items: { platformName: string; link: string }) => (
        <>
          <span class="text-gray-300" aria-hidden="true">
            ·
          </span>
          <a href={items.link} target="_blank" rel="noopener noreferrer">
            {items.platformName}
          </a>
        </>
      ))
    }
  </article>
</section>

<script
  type="module"
  define:vars={{
    dynamicContactInfo: aboutMe.dynamicContactInfo,
    defaultContactInfo: aboutMe.defaultContactInfo,
    lang: lang,
  }}
>
  import { checkContinentCodeHelper } from "./src/utils/helpers";

  async function init() {
    if (defaultContactInfo?.isActive === true) {
      return;
    }

    const regionInfo = await checkContinentCodeHelper(dynamicContactInfo);
    if (!regionInfo) return;

    const { city, cityEs, country, countryEs, phone } = regionInfo;
    const locationContent = document.getElementById("location-based-content");
    const phoneContent = document.getElementById("phone-based-content");

    if (locationContent && phoneContent) {
      const localizedCity = lang === "es" ? (cityEs ?? city) : city;
      const localizedCountry = lang === "es" ? (countryEs ?? country) : country;
      locationContent.textContent = `${localizedCity}, ${localizedCountry}`;
      phoneContent.textContent = phone;
    }
  }

  init();
</script>
