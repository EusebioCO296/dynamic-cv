---
import { loadQuery } from "../sanity/lib/load-query";

interface bio {
  bio: any;
}

const { data } = await loadQuery<bio[]>({
  query: `*[_type == "aboutMe"] {
    bio
  }`,
});

const aboutMe = data[0];
---

<section class="text-gray-900">
  <!-- Bio -->
  <article class="font-normal"></article>
  <p class="text-xl lg:text-2xl font-medium mb-2 lg:mb-4">About Me</p>
  <p
    class="font-normal text-gray-800 text-justify text-sm lg:text-base leading-relaxed"
  >
    {aboutMe.bio}
  </p>
</section>
