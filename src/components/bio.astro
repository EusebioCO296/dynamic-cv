---
import { loadQuery } from "../sanity/lib/load-query";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props as Props;

interface bio {
  bio: any;
  bioEs?: any;
}

const { data } = await loadQuery<bio[]>({
  query: `*[_type == "aboutMe"] {
    bio,
    bioEs
  }`,
});

const aboutMe = data[0];
const bio = lang === "es" ? (aboutMe.bioEs ?? aboutMe.bio) : aboutMe.bio;
---

<section class="text-gray-900">
  <!-- Bio -->
  <article class="font-normal"></article>
  <p class="text-xl lg:text-2xl font-medium mb-2 lg:mb-4">{t(lang, "aboutMe")}</p>
  <p class="font-normal text-gray-800 text-justify text-base leading-relaxed">
    {bio}
  </p>
</section>
