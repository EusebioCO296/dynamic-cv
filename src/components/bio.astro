---
import { loadQuery } from "../sanity/lib/load-query";
import type { Lang } from "../i18n/ui";

interface UiStrings {
  sectionTitles: {
    professionalProfile: { en: string; es: string };
  };
}

interface Props {
  lang?: Lang;
  ui: UiStrings;
  profile?: "ie" | "ds";
}

const { lang = "en", ui, profile = "ie" } = Astro.props as Props;

interface bio {
  bio: any;
  bioEs?: any;
  bioDs?: any;
  bioDsEs?: any;
}

const { data } = await loadQuery<bio[]>({
  query: `*[_type == "aboutMe"] {
    bio,
    bioEs,
    bioDs,
    bioDsEs
  }`,
});

const aboutMe = data[0];
const ieBio = lang === "es" ? (aboutMe.bioEs ?? aboutMe.bio) : aboutMe.bio;
const dsBio = lang === "es" ? (aboutMe.bioDsEs ?? aboutMe.bioDs) : aboutMe.bioDs;
const bio = (profile === "ds" && dsBio) || ieBio;
const bioParagraphs = (bio ?? "").split("\n\n").filter(Boolean);
---

<section class="text-gray-900">
  <!-- Bio -->
  <p class="section-title text-xl lg:text-2xl font-medium mb-2 lg:mb-4">
    {ui.sectionTitles.professionalProfile[lang]}
  </p>
  <div class="flex flex-col gap-3 lg:gap-4">
    {
      bioParagraphs.map((paragraph) => (
        <p class="font-normal text-gray-800 text-justify text-base leading-relaxed">
          {paragraph}
        </p>
      ))
    }
  </div>
</section>
