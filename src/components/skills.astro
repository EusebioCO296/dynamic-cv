---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "./portable-text.astro";
import type { Lang } from "../i18n/ui";

interface UiStrings {
  sectionTitles: {
    skills: { en: string; es: string };
  };
}

interface Props {
  lang?: Lang;
  ui: UiStrings;
}

const { lang = "en", ui } = Astro.props as Props;

interface Skills {
  skills: any[];
  skillsEs?: any[];
}

const { data } = await loadQuery<Skills[]>({
  query: `*[_type == "aboutMe"] {
    skills,
    skillsEs
  }`,
});

const aboutMe = data[0];
const skills =
  lang === "es" ? (aboutMe.skillsEs ?? aboutMe.skills) : aboutMe.skills;
---

<section class="text-gray-900">
  <p class="section-title text-xl lg:text-2xl font-medium mb-2 lg:mb-4">
    {ui.sectionTitles.skills[lang]}
  </p>
  <div
    id="block-content"
    class="font-normal text-gray-800 leading-relaxed"
  >
    <PortableText portableText={skills} />
  </div>
</section>
