---
import WorkExperience from "./work-experience.astro";
import AboutMe from "./about-me.astro";
import Bio from "./bio.astro";
import Skills from "./skills.astro";
import Volunteering from "./volunteering.astro";
import Education from "./education.astro";
import { Icon } from "astro-icon/components";
import { Layout } from "../layouts";
import { loadQuery } from "../sanity/lib/load-query";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  profile?: "ie" | "ds";
}

const { lang = "en", profile = "ie" } = Astro.props as Props;

// IE conserva las URLs originales (/resume/es); DS añade el sufijo /ds.
const hrefFor = (l: Lang, prof: "ie" | "ds") =>
  `/resume/${l}${prof === "ds" ? "/ds" : ""}`;

const title = lang === "es" ? "CV" : "Resume";

interface UiStrings {
  sectionTitles: {
    professionalProfile: { en: string; es: string };
    skills: { en: string; es: string };
    workExperience: { en: string; es: string };
    volunteering: { en: string; es: string };
    education: { en: string; es: string };
  };
  present: { en: string; es: string };
}

const { data: ui } = await loadQuery<UiStrings>({
  query: `*[_type == "uiStrings"][0]`,
});
---

<Layout title={title} lang={lang}>
  <div class="main-container mx-4 lg:mx-0 py-10 lg:py-16">
    <main
      id="main-content"
      class="max-w-3xl mx-auto pb-24 flex flex-col gap-6 lg:gap-8"
    >
      <AboutMe lang={lang} profile={profile} />
      <Bio lang={lang} ui={ui} profile={profile} />
      <Skills lang={lang} ui={ui} profile={profile} />
      <WorkExperience lang={lang} ui={ui} />
      <Volunteering lang={lang} ui={ui} />
      <Education lang={lang} ui={ui} />
    </main>

    <!-- Language + profile toggles: una sola grilla para que los "|" queden alineados -->
    <div
      class="fixed top-5 right-5 lg:right-10 text-sm font-medium z-10 grid grid-cols-[auto_auto_auto] items-center gap-x-1 gap-y-2 bg-white px-2 py-1 rounded"
    >
    <div id="lang-toggle" class="contents">
      <a
        href={hrefFor("es", profile)}
        title={lang === "es" ? "Ya estás en Español" : "Cambiar a Español"}
        aria-current={lang === "es" ? "page" : undefined}
        class={`transition ease-in-out duration-200 hover:text-gray-500 ${lang === "es" ? "text-gray-900" : "text-gray-400"}`}
      >
        ES
      </a>
      <span class="text-gray-300">|</span>
      <a
        href={hrefFor("en", profile)}
        title={lang === "en" ? "You are already in English" : "Switch to English"}
        aria-current={lang === "en" ? "page" : undefined}
        class={`transition ease-in-out duration-200 hover:text-gray-500 ${lang === "en" ? "text-gray-900" : "text-gray-400"}`}
      >
        EN
      </a>
    </div>

    <div id="profile-toggle" class="contents">
      <a
        href={hrefFor(lang, "ds")}
        title={
          profile === "ds"
            ? lang === "es"
              ? "Ya estás en el perfil de Desarrollador de Software"
              : "You are already on the Software Developer profile"
            : lang === "es"
              ? "Cambiar al perfil de Desarrollador de Software"
              : "Switch to the Software Developer profile"
        }
        aria-current={profile === "ds" ? "page" : undefined}
        class={`transition ease-in-out duration-200 hover:text-gray-500 ${profile === "ds" ? "text-gray-900" : "text-gray-400"}`}
      >
        DS
      </a>
      <span class="text-gray-300">|</span>
      <a
        href={hrefFor(lang, "ie")}
        title={
          profile === "ie"
            ? lang === "es"
              ? "Ya estás en el perfil de Ingeniero Electrónico"
              : "You are already on the Electronic Engineer profile"
            : lang === "es"
              ? "Cambiar al perfil de Ingeniero Electrónico"
              : "Switch to the Electronic Engineer profile"
        }
        aria-current={profile === "ie" ? "page" : undefined}
        class={`transition ease-in-out duration-200 hover:text-gray-500 ${profile === "ie" ? "text-gray-900" : "text-gray-400"}`}
      >
        IE
      </a>
    </div>
    </div>

    <button
      id="print-button"
      onclick="window.print()"
      type="button"
      title="Print"
      class="fixed bottom-10 right-5 lg:right-10 rounded-full bg-gray-900 p-2 text-white hover:bg-gray-300 transition ease-in-out duration-200 z-10"
    >
      <Icon name="printer" class="w-6 h-6" />
    </button>
  </div>
</Layout>

<style>
  :global(#block-content ul) {
    list-style-type: disc;
    @apply ml-5 space-y-1.5;
  }

  :global(#block-content li) {
    @apply pl-1;
  }

  :global(#block-content strong) {
    @apply font-semibold text-gray-900;
  }

  :global(.section-title) {
    break-after: avoid;
    page-break-after: avoid;
  }

  :global(.cv-entry) {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  @media print {
    @page {
      size: A4;
      margin: 20px 28px;
    }

    html {
      @apply text-[68%];
    }

    body {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      padding: 0 !important;
    }

    .main-container {
      display: block;
      padding: 0 !important;
    }

    #main-content {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      gap: 1rem !important;
    }

    #print-button {
      display: none !important;
    }

    #lang-toggle,
    #profile-toggle {
      display: none !important;
    }
  }
</style>
