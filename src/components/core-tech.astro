---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "./portable-text.astro";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props as Props;

interface CoreTech {
  coreTech?: any[];
  coreTechEs?: any[];
}

const { data } = await loadQuery<CoreTech[]>({
  query: `*[_type == "aboutMe"] {
    coreTech,
    coreTechEs
  }`,
});

const aboutMe = data[0];
const coreTech =
  lang === "es" ? (aboutMe.coreTechEs ?? aboutMe.coreTech) : aboutMe.coreTech;
---

{
  coreTech && coreTech.length > 0 && (
    <section class="text-gray-900">
      <p class="section-title text-xl lg:text-2xl font-medium mb-2 lg:mb-4">
        {t(lang, "coreTech")}
      </p>
      <div id="block-content" class="font-normal text-gray-800 leading-relaxed">
        <PortableText portableText={coreTech} />
      </div>
    </section>
  )
}
