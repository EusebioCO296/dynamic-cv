---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "../components/portable-text.astro";
import { formatDateRangeHelper } from "../utils/helpers";
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props as Props;

interface education {
  title: string;
  degree: string;
  degreeEs?: string;
  startDate: string;
  endDate: string;
  current: boolean;
  institutionOrSchool: string;
  description: any[];
  descriptionEs?: any[];
  chronoIndex: number;
}

const { data } = await loadQuery<education[]>({
  query: `*[_type == "education"] {
    title,
    degree,
    degreeEs,
    startDate,
    endDate,
    current,
    institutionOrSchool,
    description,
    descriptionEs,
    chronoIndex
  }`,
});
---

<section>
  <!-- Education -->
  <article>
    <p class="section-title text-xl lg:text-2xl font-medium mb-2 lg:mb-4">
      {t(lang, "education")}
    </p>
    {
      data
        ?.sort((a, b) => b.chronoIndex - a.chronoIndex)
        ?.map((items) => {
          const { formattedStart, formattedEnd } = formatDateRangeHelper(
            {
              startDate: items.startDate,
              endDate: items.endDate,
              current: items.current,
            },
            lang,
          );

          const degree =
            lang === "es" ? (items.degreeEs ?? items.degree) : items.degree;
          const description =
            lang === "es"
              ? (items.descriptionEs ?? items.description)
              : items.description;

          return (
            <article class="cv-entry my-4">
              <p class="text-base lg:text-lg font-semibold lg:font-medium">
                {degree}
              </p>
              <p class="text-base lg:text-lg italic font-semibold lg:font-medium">
                {items.institutionOrSchool} | {formattedStart} - {formattedEnd}
              </p>
              <div
                class="font-normal text-gray-800 text-justify leading-relaxed"
                id="block-content"
              >
                <PortableText portableText={description} />
              </div>
            </article>
          );
        })
    }
  </article>
</section>
