---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "../components/portable-text.astro";
import { formatDateRangeHelper } from "../utils/helpers";

interface education {
  title: string;
  degree: string;
  startDate: string;
  endDate: string;
  current: boolean;
  institutionOrSchool: string;
  description: any[];
  chronoIndex: number;
}

const { data } = await loadQuery<education[]>({
  query: `*[_type == "education"] {
    title,
    degree,
    startDate,
    endDate,
    current,
    institutionOrSchool,
    description,
    chronoIndex
  }`,
});
---

<section>
  <!-- Education -->
  <article>
    <p class="text-xl lg:text-2xl font-medium mb-2 lg:mb-4">Education</p>
    {
      data
        ?.sort((a, b) => b.chronoIndex - a.chronoIndex)
        ?.map((items) => {
          const { formattedStart, formattedEnd } = formatDateRangeHelper({
            startDate: items.startDate,
            endDate: items.endDate,
            current: items.current,
          });

          return (
            <article class="my-3">
              <p class="text-base lg:text-lg font-semibold lg:font-medium">
                {items.degree}
              </p>
              <p class="text-base lg:text-lg italic font-semibold lg:font-medium">
                {items.institutionOrSchool} | {formattedStart} - {formattedEnd}
              </p>
              <div
                class="font-normal text-gray-800 text-justify leading-relaxed"
                id="block-content"
              >
                <PortableText portableText={items.description} />
              </div>
            </article>
          );
        })
    }
  </article>
</section>
