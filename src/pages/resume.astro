---
import WorkExperience from "../components/work-experience.astro";
import AboutMe from "../components/about-me.astro";
import Bio from "../components/bio.astro";
import Volunteering from "../components/volunteering.astro";
import Education from "../components/education.astro";
import { Icon } from "astro-icon/components";
import { Layout } from "../layouts";
---

<Layout title="Resume">
  <div
    class="main-container mx-4 lg:mx-0 py-5 lg:py-16 lg:flex lg:justify-center h-screen"
  >
    <aside class="w-full lg:w-[400px] lg:sticky lg:top-16">
      <AboutMe />
    </aside>
    <main
      id="main-content"
      class="pb-32 lg:pb-0 w-full lg:w-[600px] lg:h-[calc(100vh-5rem)] overflow-y-auto lg:px-5 scrollbar-thin scrollbar-thumb-gray-400 scrollbar-track-gray-100 hover:scrollbar-thumb-gray-500 relative"
    >
      <div
        id="scroll-indicator"
        class="hidden lg:block absolute bottom-0 left-0 w-full h-10 bg-white flex justify-center items-center transition ease-in-out duration-200"
      >
        <Icon
          id="scroll-indicator-icon"
          name="arrow-down"
          class="w-8 h-8 absolute left-1/2 -translate-x-1/2 animate-bounce"
        />
      </div>
      <hr
        class="separator-mobile w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2 block lg:hidden"
      />
      <Bio />
      <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />
      <WorkExperience />
      <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />
      <Volunteering />
      <hr class="separator w-full lg:w-96 border-0 bg-gray-900 h-0.5 my-2" />
      <Education />
    </main>
    <button
      id="print-button"
      onclick="window.print()"
      type="button"
      title="Print"
      class="fixed bottom-10 right-5 lg:right-10 rounded-full bg-gray-900 p-2 text-white hover:bg-gray-300 transition ease-in-out duration-200 z-10"
    >
      <Icon name="printer" class="w-6 h-6" />
    </button>
  </div>
</Layout>

<style>
  @media print {
    @page {
      size: A4;
      margin: 20px;
    }

    html {
      @apply text-[55%];
    }

    body {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      padding: 0 !important;
    }

    .main-container {
      display: flex;
    }

    .separator-mobile {
      display: none !important;
    }

    .separator {
      width: 200px !important;
    }

    aside {
      @apply w-[250px];
      margin-left: 30px;
    }

    main {
      @apply w-[400px] overflow-visible;
    }

    #scroll-indicator {
      display: none !important;
    }

    #scroll-indicator-icon {
      display: none !important;
    }

    #print-button {
      display: none !important;
    }

    .scrollbar-thin {
      scrollbar-width: none;
    }
  }
</style>

<script>
  const mainContent = document.getElementById("main-content");
  const scrollIndicator = document.getElementById("scroll-indicator");

  function checkScroll() {
    if (!mainContent || !scrollIndicator) return;

    const isScrollable = mainContent.scrollHeight > mainContent.clientHeight;
    scrollIndicator.style.display = isScrollable ? "flex" : "none";

    mainContent.addEventListener("scroll", () => {
      if (mainContent.scrollTop > 20) {
        scrollIndicator.classList.add("opacity-0");
      } else {
        scrollIndicator.classList.remove("opacity-0");
      }
    });
  }

  window.addEventListener("load", checkScroll);
  window.addEventListener("resize", checkScroll);
</script>
